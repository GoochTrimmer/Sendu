# Copy to web/.env.local for local dev. In Vercel, set as project environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # the PUBLISHABLE key (sb_publishable_...) or legacy anon key
# Optional: your bot's username (without @) to show a one-tap t.me link on /settings
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Never put SUPABASE_SERVICE_ROLE_KEY here.
