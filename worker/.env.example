# Copy to worker/.env for local runs. In GitHub, set these as Actions secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # the SECRET key (sb_secret_...) or legacy service_role key. Worker only, never in the web app

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US           # which eBay site to search (EBAY_US, EBAY_GB, EBAY_AU, ...)

# Grailed search goes through the Algolia index its public web frontend queries.
# Copy the values from the browser network tab (see README "Setup" step 6).
GRAILED_ALGOLIA_APP_ID=MNRWEFSS2Q
GRAILED_ALGOLIA_API_KEY=
GRAILED_ALGOLIA_INDEX=Listing_by_date_added_production

REQUEST_INTERVAL_SECONDS=6
SPAM_BRAND_THRESHOLD=3
